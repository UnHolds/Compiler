%{
#include <stdio.h>
#include <stdlib.h>
#include <assert.h>
#include <stdbool.h>
#include <string.h>

#include "tree.h"
#include "register.h"

long functionNum = 0;
char* currentFunctionName = NULL;
char* parameter2odMemoryAddressRegister = "";

//for two register math operations
void mathOP2(NODEPTR_TYPE bnode, char * type, long initValue){
	bnode->regName = getRegister();
	printf("\tmov $%ld, %s\n",initValue, bnode->regName);
	printf("\t%s %s, %s\n", type, bnode->kids[1]->regName, bnode->regName);
	freeRegisterIfNotVariable(bnode->kids[1]->regName);
	printf("\t%s %s, %s\n", type, bnode->kids[0]->regName, bnode->regName);
	freeRegisterIfNotVariable(bnode->kids[0]->regName);
}

//for one register math operations
void mathOP1(NODEPTR_TYPE bnode, char * type){
	bnode->regName = getRegister();
	printf("\tmov %s, %s\n", bnode->kids[0]->regName, bnode->regName);
	printf("\t%s %s\n", type, bnode->regName);
	freeRegisterIfNotVariable(bnode->kids[0]->regName);
}

void logicOP2(NODEPTR_TYPE bnode, char * type){

	printf("\txor %%rax, %%rax\n");
	printf("\tcmp %s, %s\n", bnode->kids[1]->regName, bnode->kids[0]->regName);
	freeRegisterIfNotVariable(bnode->kids[0]->regName);
	freeRegisterIfNotVariable(bnode->kids[1]->regName);

	printf("\t%s %%al\n", type);

	bnode->regName = getRegister();
	printf("\tmov %%rax, %s\n",  bnode->regName);
}

void gotoIf(NODEPTR_TYPE bnode){
	printf("\tmov %s, %%rax\n", bnode->kids[0]->regName);
	printf("\ttest $1, %%rax\n");
	printf("\tjnz _%ld_%s\n", functionNum, bnode->kids[1]->str);
}

void calculateArrayAddress(NODEPTR_TYPE bnode){

	bnode->regName = getRegister();
	printf("\tmov %s, %s\n", bnode->kids[1]->regName, bnode->regName);
	printf("\timul $8, %s\n", bnode->regName);
	printf("\tadd %s, %s\n", bnode->kids[0]->regName, bnode->regName);

	freeRegisterIfNotVariable(bnode->kids[0]->regName);
	freeRegisterIfNotVariable(bnode->kids[1]->regName);
}

void loadParameterValueFromMemoryIntoRegister(NODEPTR_TYPE bnode){
	printf("\tadd $8, %s\n", parameter2odMemoryAddressRegister);
	printf("\tmovq (%s), %s\n", parameter2odMemoryAddressRegister, getRegisterByVariable(bnode->str));
}


//register r15 is in theory callee saved, but not anymore due to codeb
void saveCalleeSavedRegisters(){
	printf("\tpush %%r12\n");
	printf("\tpush %%r13\n");
	printf("\tpush %%r14\n");
}

void restoreCalleeSavedRegisters(){
	printf("\tpop %%r14\n");
	printf("\tpop %%r13\n");
	printf("\tpop %%r12\n");
}

void addToHeap(char* regName){
	printf("\tmovq %s, (%%r15)\n", regName);
	printf("\tadd $8, %%r15\n");
}

%}

%term INIT=0 FUNCTION=1 LABEL=2 FUNCTION_END=3 GOTO=4 VARIABLE=5 NUMBER=6 REGISTER=7 NOT=8 MINUS=9 PLUS=10 TIMES=11 AND=12 GREATER=13 EQUAL=14 RETURN=15 VARIABLE_ASSIGNMENT=16 VARIABLE_DEFINITION=17 TERM_EXECUTION=18 ARRAY_ASSIGN=19 IF=20 ARRAY_ACCESS=21 PARS=22 PARS_LAST=23 PARS_2OD=24 PARS_2OD_ADDRESS=25 FIRST_ORDER=26 MULTI_EXPR=27 MULTI_EXPR_LAST=28 FIRST_ORDER_ADDR=29
%start start
%%

start: INIT											# 1 # {printf("\t.file\t\"codea.s\"\n\t.text\n");}
start: FUNCTION										# 1 # {printf("\t.globl\t%s\n\t.type\t%s, @function\n%s:\n.LFB%ld:\n\t.cfi_startproc\n", bnode->str, bnode->str, bnode->str, functionNum); currentFunctionName=bnode->str; saveCalleeSavedRegisters();}
start: LABEL										# 1 # {printf("\t_%ld_%s:\n", functionNum, bnode->str);}
start: FUNCTION_END									# 1 # {restoreCalleeSavedRegisters(); printf("\tret\n\t.cfi_endproc\n.LFE%ld:\n\t.size\t%s, .-%s\n",functionNum, currentFunctionName, currentFunctionName); functionNum++; freeAllRegister();}
start: GOTO											# 1 # {printf("\tjmp _%ld_%s\n", functionNum, bnode->str);}
start: VARIABLE										# 1 # {bnode->regName = getRegisterByVariable(bnode->str);}
start: NUMBER										# 1 # {bnode->regName = getRegister(); printf("\tmov $%ld, %s\n", bnode->num, bnode->regName);}
start: REGISTER										# 1 # {printf("TODO register\n");} //never called??
start: NOT(start)									# 1 # {mathOP1(bnode, "not");}
start: MINUS(start)									# 1 # {mathOP1(bnode, "neg");}
start: PLUS(start, start)							# 1 # {mathOP2(bnode, "add", 0);}
start: TIMES(start, start)							# 1 # {mathOP2(bnode, "imul", 1);}
start: AND(start, start)							# 1 # {mathOP2(bnode, "and", 0xFFFFFFFFFFFFFFFF);}
start: GREATER(start, start)						# 1 # {logicOP2(bnode, "setg");} //SETG = set if greater
start: EQUAL(start, start)							# 1 # {logicOP2(bnode, "sete");} //SETE = set if equal
start: RETURN(start)								# 1 # {printf("\tmov %s, %%rax\n", bnode->kids[0]->regName); restoreCalleeSavedRegisters(); printf("\tret\n");}
start: VARIABLE_ASSIGNMENT(assignVariable, start)	# 1 # {printf("\tmov %s, %s\n", bnode->kids[1]->regName, bnode->kids[0]->regName); freeRegisterIfNotVariable(bnode->kids[1]->regName);}
start: VARIABLE_ASSIGNMENT(assignArray, start)		# 1 # {printf("\tmovq %s, (%s)\n", bnode->kids[1]->regName, bnode->kids[0]->regName); freeRegisterIfNotVariable(bnode->kids[0]->regName); freeRegisterIfNotVariable(bnode->kids[1]->regName);}
start: VARIABLE_DEFINITION(start)					# 1 # {bnode->regName = newVariableAndGetRegister(bnode->str); printf("\tmov %s, %s\n", bnode->kids[0]->regName, bnode->regName); freeRegisterIfNotVariable(bnode->kids[0]->regName);}
start: TERM_EXECUTION(start)						# 1 # {} //TODO but i think nothing needs to be done here
start: ARRAY_ASSIGN(start, start)					# 1 # {printf("TODO array asign\n");} //never called??
start: IF(start)	 								# 1 # {gotoIf(bnode);}
start: ARRAY_ACCESS(start, start)					# 1 # {calculateArrayAddress(bnode); printf("\tmovq (%s), %s\n", bnode->regName, bnode->regName);}
start: PARS(start, newParameter)					# 1 # {} //simple assignment should work because the regs are in the right order in the register file (see calling convention)
start: PARS_LAST(lastParameter)						# 1 # {}
start: PARS_2OD(start, pars_2od)					# 1 # {freeRegisterIfNotVariable(parameter2odMemoryAddressRegister);} //load values into get registers
start: PARS_2OD_ADDRESS								# 1 # {parameter2odMemoryAddressRegister = getRegister();} //parameter count must be increased, because the addr is a parameter
start: FIRST_ORDER(start, start)					# 1	# { bnode->regName = bnode->kids[0]->regName;}
start: MULTI_EXPR(start, start)						# 1 # {addToHeap(bnode->kids[0]->regName);}
start: MULTI_EXPR_LAST(start)						# 1 # {addToHeap(bnode->kids[0]->regName);}
start: FIRST_ORDER_ADDR								# 1 # {bnode->regName = getRegister(); printf("\tmov %%r15, %s\n", bnode->regName); char* tmpReg = getRegister(); printf("\tlea %s, %s\n", bnode->str, tmpReg); addToHeap(tmpReg); freeRegisterIfNotVariable(tmpReg);}

assignVariable: VARIABLE							# 1 # {bnode->regName = getRegisterByVariable(bnode->str);}
assignArray: 	ARRAY_ASSIGN(start, start)			# 1 # {calculateArrayAddress(bnode);}

newParameter: VARIABLE								# 1	# {bnode->regName = newVariableAndGetRegister(bnode->str);}
lastParameter: VARIABLE								# 1	# {bnode->regName = newVariableAndGetRegister(bnode->str);}


pars_2od: PARS(pars_2od, newParameter2OD)			# 1 # {}
pars_2od: PARS_LAST(lastParameter2OD)				# 1 # {}

newParameter2OD: VARIABLE							# 1 # {bnode->regName = newVariableAndGetRegister(bnode->str); loadParameterValueFromMemoryIntoRegister(bnode);}
lastParameter2OD: VARIABLE							# 1 # {bnode->regName = newVariableAndGetRegister(bnode->str); loadParameterValueFromMemoryIntoRegister(bnode);}
%%

extern treenode *root;
extern int yyparse(void);
void burm_reduce(NODEPTR_TYPE bnode, int goalnt);
STATEPTR_TYPE burm_label(NODEPTR_TYPE p);

void invoke_burm(NODEPTR_TYPE root) {
	burm_label(root);
	burm_reduce(root, 1);
}