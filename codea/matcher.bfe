%{
#include <stdio.h>
#include <stdlib.h>
#include <assert.h>
#include <stdbool.h>
#include <string.h>

#include "tree.h"
#include "register.h"

long functionNum = 0;
char* currentFunctionName = NULL;

void mathOP(NODEPTR_TYPE bnode, char * type, long initValue){
	bnode->regName = getRegister();
	printf("\tmov $%ld, %s\n",initValue, bnode->regName);
	printf("\t%s %s, %s\n", type, bnode->kids[1]->regName, bnode->regName);
	freeRegisterIfNotVariable(bnode->kids[1]->regName);
	printf("\t%s %s, %s\n", type, bnode->kids[0]->regName, bnode->regName);
	freeRegisterIfNotVariable(bnode->kids[0]->regName);
}

%}

%term INIT=0 FUNCTION=1 LABEL=2 FUNCTION_END=3 GOTO=4 VARIABLE=5 NUMBER=6 REGISTER=7 NOT=8 MINUS=9 PLUS=10 TIMES=11 AND=12 GREATER=13 EQUAL=14 RETURN=15 VARIABLE_ASSIGNMENT=16 VARIABLE_DEFINITION=17 TERM_EXECUTION=18 ARRAY_ASSIGN=19 IF=20 ARRAY_ACCESS=21 PARS=22
%start start
%%

start: INIT											# 1 # {printf("\t.file\t\"codea.s\"\n\t.text\n");}
start: FUNCTION										# 1 # {printf("\t.globl\t%s\n\t.type\t%s, @function\n%s:\n.LFB%ld:\n\t.cfi_startproc\n", bnode->str, bnode->str, bnode->str, functionNum); currentFunctionName=bnode->str;}
start: LABEL										# 1 # {printf("\t_%ld_%s:\n", functionNum, bnode->str);}
start: FUNCTION_END									# 1 # {printf("\tret\n\t.cfi_endproc\n.LFE%ld:\n\t.size\t%s, .-%s\n",functionNum, currentFunctionName, currentFunctionName); functionNum++; freeAllRegister();}
start: GOTO											# 1 # {printf("\tjmp _%ld_%s\n", functionNum, bnode->str);}
start: VARIABLE										# 1 # {bnode->regName = getRegisterByVariable(bnode->str);}
start: NUMBER										# 1 # {bnode->regName = getRegister(); printf("\tmov $%ld, %s\n", bnode->num, bnode->regName);}
start: REGISTER										# 1 # {printf("TODO register\n");}
start: NOT(start)									# 1 # {printf("TODO not\n");}
start: MINUS(start)									# 1 # {bnode->regName = bnode->kids[0]->regName; printf("\tneg %s\n", bnode->regName);}
start: PLUS(start, start)							# 1 # {mathOP(bnode, "add", 0);}
start: TIMES(start, start)							# 1 # {mathOP(bnode, "imul", 1);}
start: AND(start, start)							# 1 # {mathOP(bnode, "and", 0xFFFFFFFFFFFFFFFF);}
start: GREATER(start, start)						# 1 # {printf("TODO greater\n");}
start: EQUAL(start, start)							# 1 # {printf("TODO equal\n");}
start: RETURN(start)								# 1 # {printf("\tmov %s, \%rax\n\tret\n", bnode->kids[0]->regName);}
start: VARIABLE_ASSIGNMENT(assignVariable, start)	# 1 # {printf("\tmov %s, %s\n", bnode->kids[1]->regName, bnode->kids[0]->regName); freeRegisterIfNotVariable(bnode->kids[1]->regName);}
start: VARIABLE_ASSIGNMENT(assignArray, start)		# 1 # {printf("TODO variable array assignment\n");}
start: VARIABLE_DEFINITION(start)					# 1 # {bnode->regName = newVariableAndGetRegister(bnode->str); printf("\tmov %s, %s\n", bnode->kids[0]->regName, bnode->regName); freeRegisterIfNotVariable(bnode->kids[0]->regName);}
start: TERM_EXECUTION(start)						# 1 # {printf("TODO term execution\n");}
start: ARRAY_ASSIGN(start, start)					# 1 # {printf("TODO array asign\n");}
start: IF(start)	 								# 1 # {printf("TODO if goto\n");}
start: ARRAY_ACCESS(start, start)					# 1 # {printf("TODO array access\n");}
start: PARS(newParameter)							# 1 # {} //simple assignment should work because the regs are in the right order in the register file (see calling convention)


assignVariable: VARIABLE							# 1 # {bnode->regName = getRegisterByVariable(bnode->str);}
assignArray: 	ARRAY_ASSIGN(start, start)			# 1 # {printf("TODO array asign\n");}

newParameter: VARIABLE								# 1	# {bnode->regName = newVariableAndGetRegister(bnode->str);}
%%

extern treenode *root;
extern int yyparse(void);
void burm_reduce(NODEPTR_TYPE bnode, int goalnt);
STATEPTR_TYPE burm_label(NODEPTR_TYPE p);

void invoke_burm(NODEPTR_TYPE root) {
	burm_label(root);
	burm_reduce(root, 1);
}